# =============================================================================
# SIGNAL PARSER
# =============================================================================
def parse_signal(text):
    try:
        direction = "LONG" if "LONG" in text.upper() else "SHORT"
        sym_m  = re.search(r'ALERT:\s*([A-Z]+(?:\.[A-Z]+)?)', text, re.IGNORECASE)
        entry_m= re.search(r'Entry:\s*([\d.]+)', text)
        sl_m   = re.search(r'Stop Loss:\s*([\d.]+)', text)
        tp_m   = re.search(r'Target.*?:\s*([\d.]+)', text)
        prob_m = re.search(r'Markov Prob:\s*([\d.]+)', text)

        if not all([sym_m, entry_m, sl_m, tp_m, prob_m]):
            return None

        nse_sym = sym_m.group(1).replace(".NS","").replace(".BSE","").upper()
        us_sym  = NSE_TO_US.get(nse_sym)

        return {
            "nse_symbol": nse_sym,
            "us_symbol":  us_sym,
            "direction":  direction,
            "entry":      float(entry_m.group(1)),
            "sl":         float(sl_m.group(1)),
            "tp":         float(tp_m.group(1)),
            "prob":       float(prob_m.group(1)),
        }
    except Exception as e:
        logger.error(f"Parse error: {e}")
        return None

