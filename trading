def is_market_open(api):
    return api.get_clock().is_open


def get_current_price(api, symbol):
    try:
        bar = api.get_latest_bar(symbol)
        return float(bar.c)
    except Exception as e:
        logger.error(f"Price error {symbol}: {e}")
        return None


def get_open_positions(api):
    try:
        return {p.symbol: p for p in api.list_positions()}
    except Exception:
        return {}


def place_bracket_order(api, signal):
    us_sym    = signal["us_symbol"]
    direction = signal["direction"]
    entry_nse = signal["entry"]
    sl_nse    = signal["sl"]
    tp_nse    = signal["tp"]

    if not us_sym:
        logger.warning(f"No US symbol for {signal['nse_symbol']}. Skipping.")
        return None

    # Get current US price
    current_price = get_current_price(api, us_sym)
    if not current_price:
        logger.error(f"Cannot get price for {us_sym}. Skipping.")
        return None

    # Convert SL/TP as % offsets from NSE signal → apply to US price
    sl_pct = abs(entry_nse - sl_nse) / entry_nse
    tp_pct = abs(tp_nse   - entry_nse) / entry_nse

    if direction == "LONG":
        us_sl = round(current_price * (1 - sl_pct), 2)
        us_tp = round(current_price * (1 + tp_pct), 2)
        side  = "buy"
    else:
        us_sl = round(current_price * (1 + sl_pct), 2)
        us_tp = round(current_price * (1 - tp_pct), 2)
        side  = "sell"

    logger.info(
        f"📤 {side.upper()} {us_sym} x{QTY}\n"
        f"   US Price : ${current_price:.2f}\n"
        f"   SL       : ${us_sl:.2f}\n"
        f"   TP       : ${us_tp:.2f}"
    )

    try:
        order = api.submit_order(
            symbol        = us_sym,
            qty           = QTY,
            side          = side,
            type          = "market",
            time_in_force = "day",
            order_class   = "bracket",
            stop_loss     = {"stop_price": str(us_sl)},
            take_profit   = {"limit_price": str(us_tp)},
        )
        logger.info(f"✅ Order placed: {order.id}")
        return order.id
    except APIError as e:
        logger.error(f"❌ Order failed: {e}")
        return None


def print_summary(api):
    acc = api.get_account()
    pnl = float(acc.equity) - float(acc.last_equity)
    positions = api.list_positions()
    logger.info("─" * 45)
    logger.info(f"💰 Cash: ${float(acc.cash):,.2f} | P&L today: ${pnl:+,.2f}")
    for p in positions:
        logger.info(f"   {p.symbol}: {p.qty} shares | P&L: ${float(p.unrealized_pl):+.2f}")
    logger.info("─" * 45)

# =============================================================================
# MAIN LOOP
# =============================================================================
def run():
    logger.info("🤖 Alpaca Paper Bot starting...")
    logger.info(f"   Base URL  : {ALPACA_BASE_URL}")
    logger.info(f"   Signal URL: {SIGNAL_URL}")

    api = connect_alpaca()

    last_signal  = None
    placed_today = set()

    while True:
        try:
            now_est = datetime.now(EST)

            # Reset daily tracking at 4 PM EST (market close)
            if now_est.hour == 16 and now_est.minute == 0:
                placed_today.clear()
                logger.info("🔄 Daily tracking reset")

            # Check market hours
            if not is_market_open(api):
                nxt = api.get_clock().next_open
                logger.info(f"⏸  US Market closed. Next open: {nxt}")
                time.sleep(300)
                continue

            # Fetch signal
            try:
                res = requests.get(SIGNAL_URL, timeout=10)
                data = res.json()
            except Exception as e:
                logger.error(f"Render fetch error: {e}")
                time.sleep(POLL_INTERVAL)
                continue

            raw = data.get("signal", "").strip()
            if not raw or raw == last_signal:
                logger.debug("No new signal.")
                time.sleep(POLL_INTERVAL)
                continue

            logger.info(f"📡 New signal:\n{raw}")
            signal = parse_signal(raw)
            if not signal:
                last_signal = raw
                time.sleep(POLL_INTERVAL)
                continue

            logger.info(f"   {signal['nse_symbol']} → {signal['us_symbol']} | {signal['direction']} | Prob: {signal['prob']}%")

            # Probability filter
            if signal["prob"] < MIN_PROB:
                logger.warning(f"Prob {signal['prob']}% below {MIN_PROB}%. Skipping.")
                last_signal = raw
                time.sleep(POLL_INTERVAL)
                continue

            us_sym = signal["us_symbol"]
            if not us_sym:
                logger.warning(f"No US equivalent for {signal['nse_symbol']}. Skipping.")
                last_signal = raw
                time.sleep(POLL_INTERVAL)
                continue

            # Already traded today?
            if us_sym in placed_today:
                logger.info(f"{us_sym} already traded today. Skipping.")
                last_signal = raw
                time.sleep(POLL_INTERVAL)
                continue

            # Already in position?
            if us_sym in get_open_positions(api):
                logger.info(f"{us_sym} already open. Skipping.")
                last_signal = raw
                time.sleep(POLL_INTERVAL)
                continue

            # Place order
            order_id = place_bracket_order(api, signal)
            if order_id:
                placed_today.add(us_sym)
                print_summary(api)

            last_signal = raw

        except Exception as e:
            logger.error(f"Bot error: {e}")
            try:
                api = connect_alpaca()
            except Exception:
                pass

        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    run()
